// ─────────────────────────────────────────────────────────────
// Design Department PM System — Prisma schema
// Datasource: Postgres (Zeabur-managed)
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Staff {
  id         Int       @id @default(autoincrement())
  name       String    @unique
  email      String    @unique
  password   String // bcrypt hash
  role       String    @default("member") // 'admin' | 'member'
  active     Boolean   @default(true)
  joined     DateTime  @db.Date
  departedOn DateTime? @db.Date
  seniority  String // 'senior' | 'mid' | 'junior'
  roleTitle  String    @default("設計師")
  color      String?   // v4.8: 個人代表色 palette key (e.g. 'teal' | 'sea' | …)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  ownedCases        Case[]         @relation("owner")
  collaboratedCases Case[]         @relation("collaborators")
  createdCases      Case[]         @relation("creator")
  notifications     Notification[]
  vacations         Vacation[]      // v4.0
  businessTrips     BusinessTrip[]  // v4.0

  @@map("staff")
}

// v4.0: 休假
model Vacation {
  id        Int      @id @default(autoincrement())
  staffId   Int
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  type      String   @default("annual") // annual | sick | personal | other
  note      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staffId])
  @@index([startDate, endDate])
  @@map("vacations")
}

// v4.0: 出差
model BusinessTrip {
  id        Int      @id @default(autoincrement())
  staffId   Int
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  hotel     String   // 出差館別
  task      String   // 任務說明
  note      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staffId])
  @@index([startDate, endDate])
  @@map("business_trips")
}

model Case {
  id            String   @id // e.g., "SS-2026-04-001"
  title         String
  subTitle      String?
  requester     String
  hotel         String?
  level         String // SS/S/A/B/C/D
  category      String?
  status        String   @default("todo") // todo/wait/doing/review/done
  urgent        Boolean  @default(false)
  note          String   @default("")
  contact       String?  // B2: 案件聯絡人（選填）
  deliverables  Json?    // C1: 製作物項目（多選，字串陣列）
  needsOutsourcing Boolean @default(false) // D2: 需發包（預留 7–10 工作天）
  openDate      DateTime @db.Date
  dispatchDate  DateTime @db.Date
  copyDate      DateTime? @db.Date
  goLiveDate    DateTime @db.Date
  archivePath   String?
  archived      Boolean  @default(false)
  closedOn      DateTime? @db.Date
  requestCount  Int?
  outputCount   Int?
  actualWorkdays Int?
  items         Json?
  logs          Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  designerId    Int
  designer      Staff    @relation("owner", fields: [designerId], references: [id])
  collaborators Staff[]  @relation("collaborators")

  createdById   Int?
  createdBy     Staff?   @relation("creator", fields: [createdById], references: [id])

  transferLogs TransferLog[]
  changeLogs   ChangeLog[]

  @@index([status])
  @@index([archived])
  @@index([designerId])
  @@index([createdById])
  @@map("cases")
}

model ChangeLog {
  id        Int      @id @default(autoincrement())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  field     String   // goLiveDate | dispatchDate | copyDate | designerId | status | level | urgent | other
  fromValue String?
  toValue   String?
  reason    String
  operator  String
  createdAt DateTime @default(now())

  @@index([caseId, createdAt])
  @@map("change_logs")
}

model TransferLog {
  id       Int      @id @default(autoincrement())
  caseId   String
  case     Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  fromName String
  toName   String
  date     DateTime @default(now())
  reason   String // 主管派發 | 離職移轉 | 自願轉移
  operator String

  @@map("transfer_logs")
}

model Notification {
  id            Int      @id @default(autoincrement())
  type          String // caseAssigned | collabInvite | statusChange | staffAdd | departure | overdue
  recipientId   Int
  recipient     Staff    @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  subject       String
  body          String
  relatedCaseId String?
  createdAt     DateTime @default(now())
  readAt        DateTime?

  @@index([recipientId, readAt])
  @@map("notifications")
}

// v3.7: 館別字典（admin 可動態新增 / 編輯 / 隱藏）
model Hotel {
  id        Int      @id @default(autoincrement())
  region    String                 // 集團 / 新竹 / 台南 / 宜蘭 / 花蓮 / 嘉義 / 台中…
  name      String   @unique       // 集團本部 / 新竹湖濱館 / 礁溪館 / …
  sortOrder Int      @default(0)   // 顯示順序（小→大）
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("hotels")
}

// v4.7: 需求單位字典（admin 可動態新增 / 編輯 / 隱藏）
model RequestUnit {
  id        Int      @id @default(autoincrement())
  name      String   @unique       // 餐飲行銷 / 客房行銷 / 集團執辦 / 工務 / ...
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("request_units")
}
