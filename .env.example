NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://local_user:replace_with_local_password@127.0.0.1:5432/design_pm_local
APP_BASE_URL=http://localhost:3000
# Use a random secret; production requires at least32bytes and refuses placeholders.
JWT_SECRET=replace-with-your-own-random-secret
# Bootstrap is explicit, for completely empty business databases only.
# BOOTSTRAP_EMPTY_DATABASE=yes
# SEED_ADMIN_EMAIL=admin@example.invalid
# SEED_ADMIN_NAME=Administrator
# SEED_ADMIN_PASSWORD=
# SMTP is optional. Leave unset in local/restore tests to prevent real email.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_SECURE=false
